#!/usr/bin/env python3
"""Polling bridge between the Omarchy shell and a Loxone Miniserver.

QML has no HTTP or WebSocket client: Quickshell's Io module offers Process,
unix-domain Socket and FileView, so the shell talks to the Miniserver through
this helper process instead, the same way Omarchy's other plugins reach for
one (weather calls curl, tailscale calls the tailscale CLI).

Everything is NDJSON — one JSON object per line, in both directions. The shell
writes commands on our stdin and reads events from our stdout.

Why polling, not the Miniserver's push WebSocket — mostly
------------------------------------------------------------
A Loxone Miniserver's live-update channel is a proprietary binary protocol
layered on its WebSocket endpoint: an RSA key exchange followed by an
HMAC-signed token handshake (see Loxone's own "Loxone Web Services" spec).
Building that without a third-party crypto library — required to keep this
plugin installing with no pip, no virtualenv and no first-run download, see
AGENTS.md — sounds like it needs one, but does not: the handshake only ever
needs RSA *public-key encryption*, never decryption or key generation, which
is DER-parsing plus modular exponentiation (`pow(base, exp, mod)`, built in
and already efficient for arbitrary-precision integers) — both squarely
within the standard library. See RsaPublicKey/rsa_pkcs1v15_encrypt and
WebSocketClient below.

Even so, the bridge does not use this to replace HTTP polling wholesale —
every command and every *other* control's live state is still a single
HTTPS GET behind Basic auth (`/data/LoxApp3.json` for the structure,
`/dev/sps/io/<uuid>/all` for a control's current state, `/jdev/sps/io/
<uuid>/<command>` to act on one — the same endpoints the reference `lox`
CLI uses), polled every couple of seconds. The one confirmed, narrow
exception is `LightControllerV2`: verified live against a real Miniserver,
its `/all` HTTP response's `value` does not change with the control's actual
state at all, so there is no polling interval short enough to fix it — only
its `activeMoods` push state (`[778]` is Loxone's system-reserved "off" mood;
anything else is on) is reliable. LivePushThread exists solely to subscribe
to that one state, for that one control type; it is a narrow, best-effort
enhancement layered on top of the polling architecture, not a replacement
for it — if the handshake or connection fails for any reason (older
firmware, network hiccup), CommandWorker's own optimistic hint keeps that
control type usable regardless (see build_entity).

Commands (stdin)
    {"protocolVersion":1,"op":"config","generation":7,
     "url":"https://192.168.1.77","username":"admin","password":"...",
     "verifyTls":false}
        Connect, or reconnect with new credentials. The password arrives here
        rather than in argv because /proc/<pid>/cmdline is readable by every
        process running as this user.
    {"op":"command","entity_id":"light.<uuid>","command":"on",
     "value":40,"tag":"..."}
    {"op":"refresh"}       re-poll every control right away
    {"op":"registries"}    re-send the rooms list
    {"op":"disconnect","generation":8}
    {"op":"camera_config","url":"https://cam.local/mjpg/video.cgi",
     "username":"...","password":"...","verifyTls":false,
     "framePath":"/home/user/.config/omarchy/loxone/camera.jpg"}
        Independent of the Miniserver connection — a camera can be configured
        with or without one. Only records credentials; does not by itself
        start pulling frames (see camera_resume) unless a viewer already has
        the stream open when the config changes. See CameraWorker for the
        stream itself.
    {"op":"camera_resume"}   start pulling frames — sent when a viewer (the
                              popover, or Settings' Camera tab) opens
    {"op":"camera_pause"}    stop pulling frames — sent when the last viewer
                              closes, so an unwatched camera does not run
                              its network and encoder cost for nothing
    {"op":"camera_disconnect"}
    {"op":"shutdown"}

Events (stdout)
    Every event includes protocolVersion; the Miniserver-connection events
    additionally carry generation (the camera has its own independent
    lifecycle, so its events do not).
    {"ev":"phase","phase":"idle|connecting|connected|error",
     "error":"...","errorKind":"connection|synchronization|credential|protocol"}
    {"ev":"states","entities":[...]}          full snapshot, replaces the model
    {"ev":"state_changed","entity":{...}}     single entity changed
    {"ev":"registries","rooms":[{"area_id":...,"name":...}]}
    {"ev":"result","tag":"...","ok":true,"error":"...",
     "errorKind":"command"}
    {"ev":"camera","status":"idle|connecting|streaming|error","error":"..."}
        The frame itself is not on the wire — CameraWorker writes it straight
        to `framePath`; the shell rereads that file on its own timer. NDJSON
        stdout is one JSON object per *line*, which is a bad transport for a
        binary JPEG, and the shell already knows how to reload a local file.
    {"ev":"log","level":"info|warn","msg":"..."}

Flags
    --demo      a self-contained fake house, no Miniserver needed; see
                DemoHouse.
"""

import base64
import hashlib
import hmac
import http.client
import json
import os
import queue
import random
import re
import socket
import ssl
import struct
import sys
import threading
import time
import urllib.parse
import uuid as uuidlib

sys.dont_write_bytecode = True

USER_AGENT = "loxone-omarchy-bridge/1"
PROTOCOL_VERSION = 1

REQUEST_TIMEOUT = 4.0
POLL_INTERVAL = 2.5

BACKOFF_START = 1.0
BACKOFF_MAX = 30.0


def now():
    return time.monotonic()


class LoxoneError(Exception):
    """Stable transport error exposed to the bridge lifecycle."""


# --------------------------------------------------------------------------
# URL handling
# --------------------------------------------------------------------------

SCHEME_TLS = {"https": True, "http": False}


def parse_miniserver_url(raw_url):
    """Validate and split a Miniserver URL into (host, port, use_tls).

    Mirrors the discipline of a browser address bar: no scheme means TLS
    (never guess http, which would put a password on the wire in the clear),
    only http/https are accepted, and credentials embedded in the URL are
    rejected rather than silently stripped.
    """
    text = str(raw_url or "").strip()
    if not text:
        raise LoxoneError("no Miniserver URL configured")
    try:
        parts = urllib.parse.urlsplit(text)
        if not parts.scheme or not parts.netloc:
            parts = urllib.parse.urlsplit("https://" + text.lstrip("/"))
        if parts.scheme not in SCHEME_TLS:
            raise LoxoneError(
                "unsupported scheme %r — use http:// or https://" % parts.scheme)
        if not parts.hostname:
            raise LoxoneError("no host in URL: %s" % text)
        if parts.username or parts.password:
            raise LoxoneError("credentials aren't allowed in the Miniserver URL")
        port = parts.port
    except ValueError as exc:
        raise LoxoneError("invalid Miniserver URL: %s" % exc) from exc
    use_tls = SCHEME_TLS[parts.scheme]
    if port is None:
        port = 443 if use_tls else 80
    return parts.hostname, port, use_tls


# --------------------------------------------------------------------------
# HTTP transport
# --------------------------------------------------------------------------


def redact(text, password):
    if password:
        text = text.replace(password, "[redacted]")
    return text


class LoxoneClient:
    """A keep-alive HTTP(S) client for one Miniserver connection.

    One instance is used sequentially by a single thread (the poller or the
    command worker each own one) — http.client connections are not
    thread-safe, so nothing here needs to be.
    """

    def __init__(self, host, port, use_tls, username, password, verify_tls):
        self.host = host
        self.port = port
        self.use_tls = use_tls
        self.username = username
        self.password = password
        self.verify_tls = verify_tls
        self._conn = None
        auth = base64_basic(username, password)
        self._headers = {"Authorization": "Basic " + auth, "User-Agent": USER_AGENT}

    def _open(self):
        if self.use_tls:
            ctx = ssl.create_default_context()
            if not self.verify_tls:
                ctx.check_hostname = False
                ctx.verify_mode = ssl.CERT_NONE
            self._conn = http.client.HTTPSConnection(
                self.host, self.port, timeout=REQUEST_TIMEOUT, context=ctx)
        else:
            self._conn = http.client.HTTPConnection(
                self.host, self.port, timeout=REQUEST_TIMEOUT)

    def get(self, path, _redirected=False):
        """GET `path`, returning (status, body_text). Retries the connection
        once on a network error before giving up."""
        for attempt in (0, 1):
            try:
                if self._conn is None:
                    self._open()
                self._conn.request("GET", path, headers=self._headers)
                resp = self._conn.getresponse()
                body = resp.read()
                status = resp.status
            except (http.client.HTTPException, OSError, ssl.SSLError) as exc:
                self.close()
                if attempt == 0:
                    continue
                raise LoxoneError(redact(str(exc), self.password)) from exc

            if status in (301, 302, 303, 307, 308) and not _redirected:
                # Miniserver Gen 2 redirects local requests to a cloud DynDNS
                # URL. Following it sends Basic-auth credentials meant for the
                # local Miniserver to a different host, so only same-host
                # redirects (a path change) are followed.
                location = resp.getheader("Location") or ""
                target = urllib.parse.urlsplit(location)
                if target.hostname and target.hostname != self.host:
                    raise LoxoneError(
                        "Blocked a redirect to a different host (%s). If "
                        "you're using a local IP, check the Miniserver's "
                        "network settings." % target.hostname)
                new_path = target.path or path
                if target.query:
                    new_path += "?" + target.query
                return self.get(new_path, _redirected=True)

            return status, body.decode("utf-8", "replace")
        raise LoxoneError("request failed after retry")

    def close(self):
        if self._conn is not None:
            try:
                self._conn.close()
            except Exception:
                pass
            self._conn = None


def base64_basic(username, password):
    return base64.b64encode(("%s:%s" % (username, password)).encode("utf-8")).decode("ascii")


# --------------------------------------------------------------------------
# Structure / control classification
# --------------------------------------------------------------------------


def domain_for_type(control_type):
    """Map a Loxone control type to one of the panel's domains.

    Loxone does not negotiate capabilities through a feature bitmask the way
    Home Assistant does — what a control can do follows from its type, which
    is exactly what this function is for. Anything not recognized falls back
    to a state-only sensor, same as an unmapped Home Assistant domain would.
    """
    t = str(control_type or "").lower()
    if "lightcontroller" in t or t == "dimmer" or "colorpicker" in t:
        return "light"
    if t == "switch":
        return "switch"
    if "jalousie" in t or "gate" in t:
        return "cover"
    if "iroomcontroller" in t:
        return "climate"
    if "lock" in t:
        return "lock"
    if t == "pushbutton":
        return "scene"
    if any(key in t for key in ("presence", "motion", "smoke", "alarm")):
        return "binary_sensor"
    return "sensor"


def extract_unit(details):
    """Pull the unit suffix off a Loxone printf-style format string, e.g.
    "%.1f°C" -> "°C". The format is the most accurate source available; a
    fixed lookup table by device class would only guess."""
    if not isinstance(details, dict):
        return ""
    for key in ("format", "actualFormat"):
        fmt = details.get(key)
        if not isinstance(fmt, str):
            continue
        match = re.search(r"%[-+0-9. ]*[dfs]", fmt)
        if not match:
            continue
        suffix = fmt[match.end():].strip()
        if suffix:
            return suffix
    return ""


class RegistryEntry:
    __slots__ = ("entity_id", "uuid", "control_type", "domain", "name",
                 "room_id", "unit", "light_off_verb")

    def __init__(self, entity_id, uuid, control_type, domain, name, room_id, unit,
                 light_off_verb=None):
        self.entity_id = entity_id
        self.uuid = uuid
        self.control_type = control_type
        self.domain = domain
        self.name = name
        self.room_id = room_id
        self.unit = unit
        self.light_off_verb = light_off_verb


def light_controller_off_verb(ctrl_uuid, ctrl):
    """A LightControllerV2's own on/off and setMood commands are silently
    accepted (HTTP 200) but were live-verified against a real Miniserver to
    have *no effect at all* on an RGB circuit's actual output — on works
    (it restores the last mood), but nothing sent to the controller itself
    turns the light back off, including the system "Aus" mood (778). The
    only command that was live-verified to actually work is an explicit
    zero-brightness color command (`hsv(0,0,0)`) sent straight to the
    controller's own ColorPickerV2 sub-control, bypassing the mood system
    entirely. See root AGENTS.md's design notes for the full story — this is
    not a guess, it was found by testing every plausible command against the
    real fixture and watching what actually happened physically."""
    sub_controls = ctrl.get("subControls")
    if not isinstance(sub_controls, dict):
        return None
    prefix = ctrl_uuid + "/"
    for sub in sub_controls.values():
        if not isinstance(sub, dict):
            continue
        sub_type = sub.get("type")
        if not isinstance(sub_type, str) or sub_type.lower() not in ("colorpickerv2", "colorpicker"):
            continue
        action = sub.get("uuidAction")
        if not isinstance(action, str) or not action.startswith(prefix):
            continue
        suffix = action[len(prefix):]
        if suffix:
            return "%s/hsv(0,0,0)" % suffix
    return None


def build_registry(structure):
    """Turn a parsed LoxApp3.json into (registry, rooms).

    registry: entity_id -> RegistryEntry
    rooms: [{"area_id": uuid, "name": ...}]
    """
    rooms_raw = structure.get("rooms") if isinstance(structure, dict) else None
    rooms = []
    if isinstance(rooms_raw, dict):
        for uuid, room in rooms_raw.items():
            if isinstance(room, dict) and isinstance(room.get("name"), str):
                rooms.append({"area_id": uuid, "name": room["name"]})

    controls = structure.get("controls") if isinstance(structure, dict) else None
    registry = {}
    if isinstance(controls, dict):
        for uuid, ctrl in controls.items():
            if not isinstance(ctrl, dict):
                continue
            name = ctrl.get("name")
            control_type = ctrl.get("type")
            if not isinstance(name, str) or not isinstance(control_type, str):
                continue
            domain = domain_for_type(control_type)
            room_id = ctrl.get("room") if isinstance(ctrl.get("room"), str) else ""
            unit = extract_unit(ctrl.get("details"))
            entity_id = "%s.%s" % (domain, uuid)
            light_off_verb = (light_controller_off_verb(uuid, ctrl)
                               if "lightcontroller" in control_type.lower() else None)
            registry[entity_id] = RegistryEntry(
                entity_id, uuid, control_type, domain, name, room_id, unit,
                light_off_verb=light_off_verb)
    return registry, rooms


def build_light_controller_watch(structure):
    """entity_id -> its `activeMoods` state UUID, for every LightControllerV2
    control. That state is the only reliable on/off signal that control type
    has — see build_entity's docstring — and it only exists on the
    Miniserver's push channel, not in any HTTP polling response, which is
    what LivePushThread subscribes to it for."""
    controls = structure.get("controls") if isinstance(structure, dict) else None
    watch = {}
    if not isinstance(controls, dict):
        return watch
    for uuid, ctrl in controls.items():
        if not isinstance(ctrl, dict):
            continue
        control_type = ctrl.get("type")
        if not isinstance(control_type, str) or "lightcontroller" not in control_type.lower():
            continue
        states = ctrl.get("states")
        active_moods = states.get("activeMoods") if isinstance(states, dict) else None
        if isinstance(active_moods, str):
            entity_id = "light.%s" % uuid
            watch[entity_id] = active_moods
    return watch


# --------------------------------------------------------------------------
# State parsing
# --------------------------------------------------------------------------

_ATTR_RE = re.compile(r'([A-Za-z_][A-Za-z0-9_]*)="([^"]*)"')


def parse_all_response(xml_text):
    """`/dev/sps/io/<uuid>/all` answers a `<LL ...>` element — self-closing
    for a simple control, but for some (LightControllerV2's per-channel
    breakdown, e.g.) with nested `<output nr="..." value="..."/>` children
    that reuse attribute names like `value`. The outer `<LL>`'s own
    attributes are what the rest of this module means by "the control's
    state" and always appear first in the raw text; a naive dict-of-all-
    matches build (last occurrence wins) would silently let the last child's
    `value` clobber the real one. First occurrence wins here instead."""
    attrs = {}
    for name, val in _ATTR_RE.findall(xml_text or ""):
        attrs.setdefault(name, val)
    return attrs


def as_float(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def build_entity(entry, attrs, light_hints=None):
    """RegistryEntry + raw `/all` attributes -> the entity dict the panel
    understands. Best-effort by design: an attribute name Loxone did not
    report is simply absent from `attributes`, never invented.

    `light_hints` (entity_id -> "on"/"off") overrides LightControllerV2's own
    on/off reading — verified live against a real Miniserver, that control's
    `/all` `value` does not change with its actual state at all (it is a
    mood-list encoding this endpoint apparently never refreshes), so trusting
    it is not a rough approximation, it is simply wrong. The plugin's own
    last command for that control is the only signal available without the
    Miniserver's push-only state protocol (see the module docstring) — see
    CommandWorker for where the hint gets set."""
    code = attrs.get("Code")
    unavailable = code is not None and code != "200"
    base_attributes = {"friendly_name": entry.name}
    if entry.room_id:
        base_attributes["area_id"] = entry.room_id

    if unavailable:
        return {"entity_id": entry.entity_id, "state": "unavailable",
                "attributes": base_attributes, "area_id": entry.room_id}

    value = as_float(attrs.get("value"))
    domain = entry.domain
    attributes = dict(base_attributes)
    state = "unknown"

    if domain == "light":
        is_dimmer = entry.control_type.lower() in ("dimmer",) \
            or "colorpicker" in entry.control_type.lower()
        if is_dimmer and value is not None:
            attributes["brightness"] = max(0.0, min(100.0, value))
            state = "on" if value > 0 else "off"
        elif light_hints is not None and entry.entity_id in light_hints:
            # Our own last command outranks the read once we have one — see
            # the docstring above for why the read cannot be trusted once
            # proven stale on a given Miniserver.
            state = light_hints[entry.entity_id]
        else:
            # No command sent yet this session, so no hint exists. Fall back
            # to the reference `lox` CLI's own off-detection (`cmd_mood`) —
            # on Miniserver firmware/configurations where this value field
            # does track mood state, this is a real first-read signal rather
            # than a shot in the dark; where it does not (verified true for
            # at least one real deployment), it will simply be replaced by a
            # hint the moment a command is sent through the panel.
            raw_value = attrs.get("value") or ""
            is_off = raw_value == "0" or raw_value.startswith("200002700")
            state = "off" if is_off else "on"
    elif domain == "switch":
        state = "on" if (value is not None and value != 0) else "off"
    elif domain == "lock":
        state = "locked" if (value is not None and value != 0) else "unlocked"
    elif domain == "cover":
        pos = as_float(attrs.get("StatePos"))
        if pos is not None:
            attributes["position"] = max(0.0, min(100.0, pos * 100.0))
            state = "open" if pos > 0.005 else "closed"
        elif value is not None:
            state = "open" if value != 0 else "closed"
    elif domain == "climate":
        for key, target in (
            ("actual", "current_temperature"), ("target", "temperature"),
            ("comfort", "temperature"),
        ):
            for attr_name, attr_value in attrs.items():
                if key in attr_name.lower():
                    parsed = as_float(attr_value)
                    if parsed is not None:
                        attributes.setdefault(target, parsed)
        state = "auto"
    elif domain == "scene":
        state = "unknown"
    elif domain == "binary_sensor":
        state = "on" if (value is not None and value != 0) else "off"
    else:
        raw = attrs.get("value")
        state = raw if raw is not None else "unknown"
        if entry.unit:
            attributes["unit_of_measurement"] = entry.unit

    return {"entity_id": entry.entity_id, "state": state, "attributes": attributes,
            "area_id": entry.room_id}


def poll_one(client, entry, light_hints=None):
    status, body = client.get("/dev/sps/io/%s/all" % entry.uuid)
    attrs = parse_all_response(body) if status == 200 else {"Code": str(status)}
    return build_entity(entry, attrs, light_hints)


# A Miniserver with a couple hundred controls (not unusual for a whole house)
# polled one control at a time over a single connection is the difference
# between a ~2-3s cycle and one running well past the interval meant to pace
# it, which reads as "the panel is out of sync" even though every poll is
# individually correct — it just hasn't gotten around to a given control yet.
# Splitting the registry across a handful of connections cuts that almost
# linearly without needing the bridge to know which controls the panel
# actually shows right now.
POLL_WORKERS = 6


def poll_all(cfg, registry, light_hints=None):
    """Poll every control in `registry`, split across POLL_WORKERS connections.
    Raises LoxoneError if any of them failed — a partial, silently-incomplete
    snapshot is worse than a clean retry of the whole thing."""
    entries = list(registry.values())
    if not entries:
        return []
    worker_count = max(1, min(POLL_WORKERS, len(entries)))
    chunks = [entries[i::worker_count] for i in range(worker_count)]
    results = [None] * worker_count
    errors = [None] * worker_count

    def run_chunk(index, chunk):
        client = LoxoneClient(**cfg)
        try:
            results[index] = [poll_one(client, entry, light_hints) for entry in chunk]
        except LoxoneError as exc:
            errors[index] = exc
        finally:
            client.close()

    threads = [threading.Thread(target=run_chunk, args=(i, chunk), daemon=True)
               for i, chunk in enumerate(chunks)]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()

    for error in errors:
        if error is not None:
            raise error

    entities = []
    for chunk_result in results:
        entities.extend(chunk_result)
    return entities


def fetch_structure(client):
    status, body = client.get("/data/LoxApp3.json")
    if status != 200:
        raise LoxoneError("could not read the Miniserver structure (HTTP %d)" % status)
    try:
        return json.loads(body)
    except ValueError as exc:
        raise LoxoneError("Miniserver structure is not valid JSON") from exc


# --------------------------------------------------------------------------
# Command translation
# --------------------------------------------------------------------------

# LightControllerV2/LightController is a mood controller, not a relay: a
# plain "on" restores the last active mood (the same trick the reference
# `lox` CLI uses before setting a mood — see `ensure_light_on_for_mood`), but
# there is no plain "off" that reliably does anything. Mood 778 ("Aus") looks
# like the system-defined off mood on paper and is silently accepted (HTTP
# 200), but live testing against a real Miniserver with an RGB circuit found
# it has no physical effect either — see `light_controller_off_verb`, which
# targets the controller's ColorPickerV2 sub-control directly and is tried
# first. This is now only the fallback for a LightControllerV2 that has no
# such sub-control to target (unverified against real hardware — better than
# nothing, not proven to work).
LIGHT_CONTROLLER_OFF = "setMood/778"


def translate_command(entry, command, value):
    """UI-level command (from Model.js) -> the verb `/jdev/sps/io/<uuid>/...`
    expects, following each control type's real command surface."""
    domain = entry.domain
    t = entry.control_type.lower()

    if domain in ("light", "switch", "lock"):
        if command == "on":
            return "on"
        if command == "off":
            if domain == "light" and "lightcontroller" in t:
                return entry.light_off_verb or LIGHT_CONTROLLER_OFF
            return "off"
        if command == "set_brightness" and domain == "light":
            level = as_float(value)
            if level is None:
                raise LoxoneError("brightness needs a numeric value")
            return "%.0f" % max(0.0, min(100.0, level))
    elif domain == "cover":
        is_gate = "gate" in t
        if command == "open_cover":
            return "open" if is_gate else "FullUp"
        if command == "close_cover":
            return "close" if is_gate else "FullDown"
        if command == "stop_cover":
            return "stop" if is_gate else "off"
    elif domain == "climate":
        if command == "set_temperature":
            target = as_float(value)
            if target is None:
                raise LoxoneError("set_temperature needs a numeric value")
            return "setComfortTemperature/%.1f" % target
    elif domain == "scene":
        if command == "activate":
            return "pulse"

    raise LoxoneError("command %r is not supported for %s" % (command, domain))


def execute_command(client, registry, entity_id, command, value):
    entry = registry.get(entity_id)
    if entry is None:
        return False, "Unknown entity %s" % entity_id
    try:
        verb = translate_command(entry, command, value)
    except LoxoneError as exc:
        return False, str(exc)
    try:
        status, body = client.get("/jdev/sps/io/%s/%s" % (entry.uuid, verb))
    except LoxoneError as exc:
        return False, str(exc)
    if status != 200:
        return False, "Miniserver rejected the command (HTTP %d)" % status
    try:
        parsed = json.loads(body)
        code = str(parsed.get("LL", {}).get("Code", "200"))
    except ValueError:
        code = "200"
    if code != "200":
        return False, "Miniserver rejected the command (code %s)" % code
    return True, ""


# --------------------------------------------------------------------------
