    ("climate", "set_fan_mode"): ("fan_mode", "fan_modes", "fan mode"),
    ("climate", "set_preset_mode"): ("preset_mode", "preset_modes", "preset"),
    ("climate", "set_swing_mode"): ("swing_mode", "swing_modes", "swing mode"),
}


