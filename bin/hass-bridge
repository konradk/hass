        return {"entity_id": entity_id, "state": state, "attributes": attributes}

    return [
        # Attribute shapes follow a current Home Assistant, not a historical
        # one: brightness support is advertised through supported_color_modes,
        # climate carries no unit of its own, and the HVAC mode is the state.
        # A demo that lies about this is how the real instance breaks.
