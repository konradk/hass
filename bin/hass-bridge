#!/usr/bin/env python3
"""WebSocket bridge between the Omarchy shell and Home Assistant.

QML has no WebSocket client: Quickshell's Io module offers Process, unix-domain
Socket and FileView, and the QtWebSockets QML module is not part of a stock Qt6
install. Omarchy's own plugins already reach for helper processes (weather calls
curl, tailscale calls the tailscale CLI), so the shell speaks to Home Assistant
through this process instead.

Everything is NDJSON — one JSON object per line, in both directions. The shell
writes commands on our stdin and reads events from our stdout.

Commands (stdin)
    {"protocolVersion":1,"op":"config","generation":7,
     "url":"https://ha.local:8123","localUrl":"https://192.168.1.50:8123",
     "trustedNetwork":"Home,Home 5G","token":"..."}
        Connect, or reconnect with new credentials. The token arrives here
        rather than in argv because /proc/<pid>/cmdline is readable by every
        process running as this user. localUrl is optional: an alternate
        address for the same instance (a LAN address, say). It is only ever
        tried, ahead of url and with a short timeout, when trustedNetwork is
        set and one of its comma-separated names matches the current Wi-Fi
        network name (checked via nmcli — a router commonly broadcasts more
        than one SSID, e.g. separate 2.4GHz/5GHz names, hence the list).
        Otherwise every attempt goes straight to url. This is what stops the
        token from being sent to whatever happens to answer at that address
        on an untrusted network — localUrl shares url's token rather than
        needing its own, so this check is the only thing standing between it
        and an unwanted disclosure.
    {"op":"call_service","domain":"light","service":"turn_on",
     "entity_id":"light.x","data":{"brightness_pct":40},"tag":"..."}
    {"op":"history","entity_id":"sensor.x","hours":1,"tag":"..."}
        Recorder history for a numeric sensor. Values are numeric or null at
        unavailable gaps. hours is 1, 3, 6, 12, or 24.
        Uses a longer request timeout than ordinary commands.
    {"op":"refresh"}       re-request the full state snapshot
    {"op":"registries"}    re-request area/entity/device registries
    {"op":"history","tag":"history:1","entity_ids":["sensor.x"],
     "hours":24}
        Batch history uses the Home Assistant server clock. Explicit start and
        end times remain accepted for older callers.
    {"op":"shutdown"}

Events (stdout)
    Every event includes protocolVersion and generation.
    {"ev":"phase","phase":"idle|connecting|connected|error",
     "error":"...","errorKind":"connection|synchronization|credential|protocol",
     "usingLocal":true}   usingLocal is present and true only when phase is
                          "connected" and the connection went through localUrl
    {"ev":"states","entities":[...]}          full snapshot, replaces the model
    {"ev":"state_changed","entity":{...}}     single entity changed
    {"ev":"removed","entity_id":"..."}        entity disappeared
    {"ev":"registries","areas":[...],"entities":[...],"devices":[...]}
    {"ev":"config","unit_temperature":"°C"}   instance-wide unit system
    {"ev":"history","tag":"history:1","histories":{"sensor.x":[
     {"t":1787824800000,"v":24.2}]},"error":""}
    {"ev":"result","tag":"...","ok":true,"error":"...",
     "errorKind":"command"}
    {"ev":"history","tag":"...","entity_id":"sensor.x","hours":1,
     "points":[{"t":1710000000.0,"v":22.3}]}
        Values are numeric or null at unavailable gaps. Attributes from Home
        Assistant are stripped.
    {"ev":"log","level":"info|warn","msg":"..."}

Flags
    --demo      a self-contained fake house, no instance needed; see
                DemoTransport.
    --insecure  skip TLS certificate verification. Debugging aid only — the
                shell never passes it, there is no setting that turns it on,
                and it must not be used with a real long-lived token.
"""

import json
import email.utils
import math
import os
import queue
import random
import re
import socket
import ssl
import subprocess
import sys
import threading
import time
import urllib.parse
from datetime import datetime, timedelta, timezone

# Runtime bytecode doesn't belong in the plugin checkout and isn't useful for
# a small long-lived helper. Set this before loading the vendored package.
sys.dont_write_bytecode = True

# The plugin must behave identically on a clean Omarchy install and on a
# developer machine that happens to have another websockets release installed.
# Resolve the vendored package relative to this executable, before importing
# anything from it.
PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VENDOR_DIR = os.path.join(PROJECT_ROOT, "vendor")
if VENDOR_DIR not in sys.path:
    sys.path.insert(0, VENDOR_DIR)

import websockets  # noqa: E402
from websockets.exceptions import (  # noqa: E402
    ConnectionClosed,
    InvalidHandshake,
    InvalidURI,
    PayloadTooBig,
    WebSocketException,
)
from websockets.sync.client import connect as websocket_connect  # noqa: E402

# What the user may type in the settings overlay, and the WebSocket scheme it
# maps to. Anything else is refused rather than guessed at.
WS_SCHEMES = {"https": "wss", "http": "ws", "wss": "wss", "ws": "ws"}

# How long we wait for Home Assistant to answer a request before giving the
# shell its error back.
REQUEST_TIMEOUT = 5.0
MAX_HISTORY_ENTITIES = 8
MAX_HISTORY_POINTS = 360
# Recorder history can be slow on modest hardware or long windows; keep that
# path separate so ordinary commands stay snappy.
HISTORY_REQUEST_TIMEOUT = 20.0

# Home Assistant's largest message is the initial get_states snapshot. Keep a
# documented finite ceiling for both complete messages and individual frames;
# max_queue below adds backpressure before several such frames can accumulate.
MAX_MESSAGE_SIZE = 32 * 1024 * 1024
MAX_FRAME_SIZE = 32 * 1024 * 1024
MAX_QUEUE_HIGH = 4
MAX_QUEUE_LOW = 1
OPEN_TIMEOUT = 10.0
CLOSE_TIMEOUT = 3.0
PING_INTERVAL = 30.0
PING_TIMEOUT = 10.0
PROTOCOL_VERSION = 1

# Reconnect backoff. Home Assistant restarts are common enough (every add-on
# update) that the first retry has to be quick, but a server that is down for
# maintenance should not be hammered.
BACKOFF_START = 1.0
BACKOFF_MAX = 30.0

# How long a local-network candidate gets before falling back to the primary
# URL. Short: the whole point is that a laptop off the home network should not
# sit there waiting out the normal OPEN_TIMEOUT before trying the URL that can
# actually answer. A closed port refuses well inside this anyway; the timeout
# only matters for an address nothing answers at all.
LOCAL_CONNECT_TIMEOUT = 2.0

# Bound on the nmcli call in current_wifi_ssid(), so a hung network stack
# cannot wedge the bridge's single-threaded run loop.
NETWORK_CHECK_TIMEOUT = 2.0

HISTORY_HOURS = (1, 3, 6, 12, 24)
HISTORY_MAX_POINTS = 240
SENSOR_ENTITY_RE = re.compile(r"^sensor\.[a-zA-Z0-9_]+$")


def normalize_history_hours(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    hours = int(value)
    if hours != value or hours not in HISTORY_HOURS:
        return None
    return hours


def valid_sensor_entity_id(entity_id):
    return isinstance(entity_id, str) and SENSOR_ENTITY_RE.match(entity_id) is not None


def parse_numeric_state(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        number = float(value)
        return number if math.isfinite(number) else None
    if isinstance(value, str):
        text = value.strip()
        if not text:
            return None
        try:
            number = float(text)
        except ValueError:
            return None
        return number if math.isfinite(number) else None
    return None


def parse_history_timestamp(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        number = float(value)
        return number if math.isfinite(number) else None
    if isinstance(value, str):
        text = value.strip()
        if not text:
            return None
        try:
            return float(text)
        except ValueError:
            pass
        try:
            stamp = datetime.fromisoformat(text.replace("Z", "+00:00"))
        except ValueError:
            return None
        return stamp.timestamp()
    return None


def parse_history_point(item):
    if not isinstance(item, dict):
        return None
    value = parse_numeric_state(item.get("s"))
    if value is None:
        value = parse_numeric_state(item.get("state"))
    if value is None:
        return None
    timestamp = parse_history_timestamp(item.get("lu"))
    if timestamp is None:
        timestamp = parse_history_timestamp(item.get("last_updated"))
    if timestamp is None:
        timestamp = parse_history_timestamp(item.get("last_changed"))
    if timestamp is None:
        return None
    return {"t": timestamp, "v": value}


def downsample_history_points(points, limit=HISTORY_MAX_POINTS):
    if not isinstance(points, list) or len(points) <= limit:
        return list(points or [])
    if limit <= 0:
        return []
    if limit == 1:
        return [points[-1]]
    last_index = len(points) - 1
    out = []
    seen = set()
    for step in range(limit):
        index = round(step * last_index / (limit - 1))
        if index in seen:
            continue
        seen.add(index)
        out.append(points[index])
    return out


def extract_history_points(result, entity_id):
    if not isinstance(result, dict):
        return []
    rows = result.get(entity_id) if isinstance(entity_id, str) else None
    if not isinstance(rows, list) and len(result) == 1:
        only = next(iter(result.values()))
        rows = only if isinstance(only, list) else []
    if not isinstance(rows, list):
        return []
    points = []
    for item in rows:
        point = parse_history_point(item)
        if point is not None:
            points.append(point)
    points.sort(key=lambda point: point["t"])
    return downsample_history_points(points)


def isoformat_z(moment):
    return moment.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")


def demo_history_points(hours, current_state):
    end = time.time()
    start = end - hours * 3600.0
    count = min(HISTORY_MAX_POINTS, max(24, hours * 60))
    span = end - start
    points = []
    for index in range(count):
        stamp = start + span * index / (count - 1)
        phase = (stamp - start) / 3600.0
        value = 22.0 + math.sin(phase * 1.7) * 1.4 + math.sin(phase * 4.3) * 0.3
        points.append({"t": stamp, "v": round(value, 2)})
    current = parse_numeric_state(current_state)
    if current is not None and points:
        points[-1] = {"t": end, "v": current}
    return points


def current_wifi_ssid():
    """Best-effort current Wi-Fi network name, or None.

    None whenever this cannot be determined with confidence — no
    NetworkManager, no active Wi-Fi, a timeout, unparseable output — not just
    when nothing matches. The local URL has to fail closed here: this is the
    only thing standing between it and sending a token to whatever happens to
    answer at that address on a network that was never trusted.
    """
    # Test-only seam. Real installs never set this; nothing in this plugin
    # sets it either. It exists because tests/test_bridge.py drives the
    # bridge as a real subprocess with no way to patch this function
    # directly, and CI has no controllable Wi-Fi to join.
    override = os.environ.get("HASS_BRIDGE_TEST_SSID")
    if override is not None:
        return override or None

    try:
        result = subprocess.run(
            # --rescan no: this only needs whatever NetworkManager already
            # knows about the currently active connection, not a fresh scan
            # of every nearby network. Without it, nmcli blocks on a full
            # radio scan — several seconds, during which this call would
            # freeze the bridge's single-threaded run loop.
            ["nmcli", "-t", "-f", "active,ssid", "dev", "wifi", "list",
             "--rescan", "no"],
            capture_output=True, text=True, timeout=NETWORK_CHECK_TIMEOUT)
    except Exception:
        return None
    if result.returncode != 0:
        return None

    for line in result.stdout.splitlines():
        # nmcli's terse output escapes a literal ':' inside a field as '\:',
        # so only an unescaped colon is a field separator.
        fields = re.split(r"(?<!\\):", line, maxsplit=1)
        if len(fields) != 2:
            continue
        active, raw_ssid = fields
        if active != "yes":
            continue
        ssid = raw_ssid.replace("\\:", ":").replace("\\\\", "\\")
        return ssid or None
    return None


def now():
    return time.monotonic()


class WebSocketError(Exception):
    """Stable transport error exposed to the bridge lifecycle."""


# --------------------------------------------------------------------------
# Transports
#
# Both transports speak the Home Assistant WebSocket protocol in terms of
# decoded JSON objects, so everything above them — auth, subscription, event
# translation, request correlation — is written once. That is what keeps demo
# mode from becoming a second code path in the shell.
# --------------------------------------------------------------------------


class WsTransport:
    kind = "live"

    def __init__(self, url, verify_tls=True, open_timeout=OPEN_TIMEOUT):
        self.url = url
        self.verify_tls = verify_tls
        self.open_timeout = open_timeout
        self.ws = None
        self.server_clock_offset = None

    def connect(self):
        ssl_context = None
        if self.url.startswith("wss://") and not self.verify_tls:
            ssl_context = ssl.create_default_context()
            ssl_context.check_hostname = False
            ssl_context.verify_mode = ssl.CERT_NONE
        try:
            self.ws = websocket_connect(
                self.url,
                ssl=ssl_context,
                proxy=None,
                compression=None,
                open_timeout=self.open_timeout,
                close_timeout=CLOSE_TIMEOUT,
                ping_interval=PING_INTERVAL,
                ping_timeout=PING_TIMEOUT,
                max_size=(MAX_MESSAGE_SIZE, MAX_FRAME_SIZE),
                max_queue=(MAX_QUEUE_HIGH, MAX_QUEUE_LOW),
            )
            response = getattr(self.ws, "response", None)
            headers = getattr(response, "headers", None)
            date_header = headers.get("Date") if headers is not None else None
            if date_header:
                server_date = email.utils.parsedate_to_datetime(date_header)
                self.server_clock_offset = server_date.timestamp() - time.time()
        except (InvalidURI, InvalidHandshake, WebSocketException, OSError,
                TimeoutError) as exc:
            raise WebSocketError(str(exc)) from exc

    def send(self, obj):
        if self.ws is None:
            raise WebSocketError("transport isn't connected")
        try:
            self.ws.send(json.dumps(obj, ensure_ascii=False))
        except (ConnectionClosed, WebSocketException, OSError) as exc:
            raise WebSocketError(str(exc)) from exc

    def receive(self, timeout):
        if self.ws is None:
            raise WebSocketError("transport isn't connected")
        try:
            message = self.ws.recv(timeout=timeout)
        except TimeoutError:
            return None
        except (ConnectionClosed, PayloadTooBig, WebSocketException,
                OSError) as exc:
            raise WebSocketError(str(exc)) from exc

        if not isinstance(message, str):
            raise WebSocketError("Home Assistant sent a binary WebSocket message")
        try:
            decoded = json.loads(message)
        except (TypeError, ValueError) as exc:
            raise WebSocketError("Home Assistant sent invalid JSON") from exc
        if not isinstance(decoded, dict):
            raise WebSocketError("Home Assistant message must be a JSON object")
        return decoded

    def close(self):
        if self.ws:
            try:
                self.ws.close()
            finally:
                self.ws = None


