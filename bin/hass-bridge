class DemoTransport:
    """A fake house that speaks the Home Assistant WebSocket protocol.

    Two things make this worth more than a fixture file. It answers real
    protocol messages, so the layers above it are exercised for real rather
    than stubbed out. And it drifts on a timer — temperature wanders, tracks
    change, the motion sensor trips — so the shell's live-update path is under
    test even with no Home Assistant on the network.
    """

    kind = "demo"

    def __init__(self):
        self._states = {e["entity_id"]: e for e in demo_initial_states()}
        self._playlist_index = 0
        self._outbox = queue.Queue()
        self._stop = threading.Event()
        self._ticker = None

    # -- transport interface ---------------------------------------------

    def connect(self):
        self._emit({"type": "auth_required", "ha_version": "demo"})
        self._ticker = threading.Thread(target=self._tick_loop, daemon=True)
        self._ticker.start()

    def close(self):
        self._stop.set()

    def receive(self, timeout):
        try:
            return self._outbox.get(timeout=timeout)
        except queue.Empty:
            return None

    def _emit(self, obj):
        self._outbox.put(obj)

    # -- protocol ---------------------------------------------------------

    def send(self, obj):
        kind = obj.get("type")
        msg_id = obj.get("id")

        if kind == "auth":
            self._emit({"type": "auth_ok", "ha_version": "demo"})
        elif kind == "subscribe_events":
            self._ok(msg_id, None)
        elif kind == "get_states":
            self._ok(msg_id, list(self._states.values()))
        elif kind == "config/area_registry/list":
            self._ok(msg_id, DEMO_AREAS)
        elif kind == "config/entity_registry/list":
            self._ok(msg_id, [
                {"entity_id": eid, "device_id": dev, "area_id": None}
                for eid, (dev, _) in DEMO_DEVICES.items()
            ])
        elif kind == "config/device_registry/list":
            self._ok(msg_id, [
                {"id": dev, "area_id": area}
                for dev, area in dict(DEMO_DEVICES.values()).items()
            ])
        elif kind == "get_config":
            self._ok(msg_id, {"unit_system": {"temperature": "°C"}})
        elif kind == "call_service":
            self._call_service(obj)
        else:
            self._fail(msg_id, "demo backend does not implement %s" % kind)

    def _ok(self, msg_id, result):
        self._emit({"id": msg_id, "type": "result", "success": True, "result": result})

    def _fail(self, msg_id, message):
        self._emit({"id": msg_id, "type": "result", "success": False,
                    "error": {"code": "demo", "message": message}})

    def _entity_id_of(self, obj):
        target = obj.get("target") or {}
        entity_id = target.get("entity_id")
        if not entity_id:
            entity_id = (obj.get("service_data") or {}).get("entity_id")
        if isinstance(entity_id, list):
            entity_id = entity_id[0] if entity_id else None
        return entity_id

    def _call_service(self, obj):
        msg_id = obj.get("id")
        domain = obj.get("domain")
        service = obj.get("service")
        data = obj.get("service_data") or {}
        entity_id = self._entity_id_of(obj)

        if entity_id not in self._states:
            self._fail(msg_id, "Unknown entity %s" % entity_id)
            return

        pair = (domain, service)
        if pair == ("scene", "turn_on"):
            self._set_state(entity_id, "scening")
            self._set_state("light.living_room_lamp", "on")
            self._set_attrs("light.living_room_lamp", {"brightness": 220})
        elif service == "turn_on" and domain in (
                "light", "switch", "fan", "input_boolean", "humidifier"):
            self._set_state(entity_id, "on")
            if domain == "light" and "brightness_pct" in data:
                pct = max(0.0, min(100.0, float(data["brightness_pct"])))
                self._set_attrs(entity_id, {
                    "brightness": round(pct / 100.0 * 255.0)})
        elif service == "turn_off" and domain in (
                "light", "switch", "fan", "input_boolean", "humidifier"):
            self._set_state(entity_id, "off")
            if domain == "light":
                # Home Assistant drops brightness to null on a dark light, which
                # is exactly when brightness must not be read as "not dimmable".
                self._set_attrs(entity_id, {"brightness": None, "color_mode": None})
        elif pair == ("climate", "turn_on"):
            self._set_state(entity_id, "heat")
            self._set_attrs(entity_id, {"hvac_action": "idle"})
        elif pair == ("climate", "turn_off"):
            self._set_state(entity_id, "off")
            self._set_attrs(entity_id, {"hvac_action": "off"})
        elif pair == ("homeassistant", "toggle"):
            current = (self._states[entity_id].get("state") or "off").lower()
            nxt = "off" if current in ("on", "playing", "open", "unlocked") else "on"
            self._set_state(entity_id, nxt)
        elif pair == ("media_player", "media_play_pause"):
            current = (self._states[entity_id].get("state") or "off").lower()
            nxt = "paused" if current == "playing" else "playing"
            self._set_state(entity_id, nxt)
            self._set_attrs(entity_id, {"media_playback_state": nxt})
        elif pair == ("media_player", "media_next_track"):
            self._advance_playlist(entity_id, 1)
        elif pair == ("media_player", "media_previous_track"):
            self._advance_playlist(entity_id, -1)
        elif pair == ("media_player", "volume_set"):
            level = max(0.0, min(1.0, float(data.get("volume_level", 0))))
            self._set_attrs(entity_id, {"volume_level": level})
        elif pair == ("cover", "open_cover"):
            self._set_state(entity_id, "open")
        elif pair == ("cover", "close_cover"):
            self._set_state(entity_id, "closed")
        elif pair == ("cover", "stop_cover"):
            self._set_state(entity_id, "stopped")
        elif pair == ("lock", "lock"):
            self._set_state(entity_id, "locked")
        elif pair == ("lock", "unlock"):
            self._set_state(entity_id, "unlocked")
        elif pair == ("climate", "set_temperature"):
            attrs = {}
            for key in ("temperature", "target_temp_low", "target_temp_high"):
                if key in data:
                    attrs[key] = float(data[key])
            self._set_attrs(entity_id, attrs)
        elif pair == ("climate", "set_hvac_mode"):
            mode = data.get("hvac_mode")
            modes = self._states[entity_id]["attributes"].get("hvac_modes") or []
            if not isinstance(mode, str) or mode not in modes:
                self._fail(msg_id, "Invalid demo climate HVAC mode.")
                return
            self._set_state(entity_id, mode)
            self._set_attrs(entity_id, {"hvac_action": "off" if mode == "off" else "idle"})
        elif pair in DEMO_CLIMATE_ATTRIBUTE_MODE_SERVICES:
            if not self._set_demo_climate_attribute_mode(msg_id, entity_id, pair, data):
                return
        else:
            self._fail(msg_id, "demo backend does not implement %s.%s" % pair)
            return

        self._ok(msg_id, None)
    def _set_demo_climate_attribute_mode(self, msg_id, entity_id, pair, data):
        payload_key, options_attribute, error_noun = (
            DEMO_CLIMATE_ATTRIBUTE_MODE_SERVICES[pair])
        mode = data.get(payload_key)
        modes = self._states[entity_id]["attributes"].get(options_attribute) or []
        if not isinstance(mode, str) or mode not in modes:
            self._fail(msg_id, "Invalid demo climate %s." % error_noun)
            return False
        self._set_attrs(entity_id, {payload_key: mode})
        return True


    def _advance_playlist(self, entity_id, step):
        self._playlist_index = (self._playlist_index + step) % len(DEMO_PLAYLIST)
        title, artist = DEMO_PLAYLIST[self._playlist_index]
        self._set_state(entity_id, "playing")
        self._set_attrs(entity_id, {
            "media_title": title, "media_artist": artist,
            "media_playback_state": "playing"})

    def _set_state(self, entity_id, state):
        entity = self._states.get(entity_id)
        if not entity or entity.get("state") == state:
            return
        entity["state"] = state
        self._push_state_changed(entity_id)

    def _set_attrs(self, entity_id, attrs):
        entity = self._states.get(entity_id)
        if not entity or not attrs:
            return
        entity.setdefault("attributes", {}).update(attrs)
        self._push_state_changed(entity_id)

    def _push_state_changed(self, entity_id):
        entity = self._states[entity_id]
        self._emit({
            "type": "event",
            "event": {
                "event_type": "state_changed",
                "data": {"entity_id": entity_id,
                         "new_state": json.loads(json.dumps(entity))},
            },
        })

    def _tick_loop(self):
        while not self._stop.wait(5.0):
            try:
                self._tick()
            except Exception:
                pass

    def _tick(self):
        thermostat = self._states["climate.living_room_thermostat"]
        current = float(thermostat["attributes"].get("current_temperature", 21.0))
        target = float(thermostat["attributes"].get("temperature", 22.0))
        # Drift a tenth of a degree towards the setpoint, with a little noise,
        # so the climate row visibly converges instead of jittering forever.
        step = 0.1 if current < target else -0.1
        current = round(current + step + random.uniform(-0.04, 0.04), 1)
        self._set_attrs("climate.living_room_thermostat", {"current_temperature": current})

        sensor = round(current + random.uniform(0.4, 1.2), 1)
        self._set_state("sensor.kitchen_temperature", str(sensor))

        if random.random() < 0.15:
            motion = self._states["binary_sensor.garage_motion"]["state"]
            self._set_state("binary_sensor.garage_motion", "off" if motion == "on" else "on")

        tv = self._states["media_player.living_room_tv"]
        if tv["state"] == "playing" and random.random() < 0.1:
            self._advance_playlist("media_player.living_room_tv", 1)


# --------------------------------------------------------------------------
# Bridge
# --------------------------------------------------------------------------


class Bridge:
    def __init__(self, demo=False, verify_tls=True):
        self.demo = demo
        self.verify_tls = verify_tls
        self.url = ""
        self.token = ""
        self.generation = 0
        self.transport_epoch = 0

        self.transport = None
        self.phase = "idle"
        self.msg_id = 1
        self.pending = {}
        self.authenticated = False
        self.subscription_ready = False
        self.snapshot_ready = False

        self.backoff = BACKOFF_START
        self.next_attempt = 0.0
        self.want_connect = False

        # Home Assistant answers the very first authentication attempt with
        # auth_invalid for a beat after a restart, before its auth provider is
        # ready. Swallow one per 30s window and retry; a second inside the
        # window is a genuinely bad token and gets surfaced.
        self.auth_invalid_count = 0
        self.auth_invalid_at = 0.0

        self.registry = {}
        self.registry_pending = set()
        self.registry_failed = set()
        self.registry_batch = 0
        self.running = True
        self._out_lock = threading.Lock()
        self._commands = queue.Queue()
        self._command_event = threading.Event()

    # -- output -----------------------------------------------------------

    def emit(self, obj):
        obj = dict(obj)
        obj.setdefault("protocolVersion", PROTOCOL_VERSION)
        if obj.get("ev") in {
                "phase", "states", "state_changed", "removed",
                "registries", "config", "result", "log"}:
            obj.setdefault("generation", self.generation)
        line = json.dumps(obj, ensure_ascii=False)
        with self._out_lock:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()

    def log(self, level, msg):
        self.emit({"ev": "log", "level": level, "msg": msg,
                   "errorKind": "warning"})

    def safe_error(self, error, fallback="Home Assistant request failed."):
        text = str(error or "").strip() or fallback
        if self.token:
            text = text.replace(self.token, "[redacted]")
        return text[:1000]

    def set_phase(self, phase, error="", force=False, error_kind="connection"):
        if phase == self.phase and not error and not force:
            return
        self.phase = phase
        payload = {"ev": "phase", "phase": phase}
        if error:
            payload["error"] = self.safe_error(error)
            payload["errorKind"] = error_kind
        self.emit(payload)

    # -- command intake ---------------------------------------------------

    def stdin_loop(self):
        for raw in sys.stdin:
            raw = raw.strip()
            if not raw:
                continue
            try:
                command = json.loads(raw)
            except ValueError:
                self.log("warn", "ignoring malformed command line")
                continue
            if not isinstance(command, dict):
                self.log("warn", "ignoring command that isn't a JSON object")
                continue
            self._commands.put(command)
            self._command_event.set()
        # stdin closed: the shell is gone, so should we be.
        self._commands.put({"op": "shutdown"})
        self._command_event.set()

    def drain_commands(self):
        self._command_event.clear()
        while True:
            try:
                command = self._commands.get_nowait()
            except queue.Empty:
                return
            try:
                self.handle_command(command)
            except Exception as exc:
                self.log("warn", "command failed: %s" % self.safe_error(exc))

    def handle_command(self, command):
        op = command.get("op")
        protocol_version = command.get("protocolVersion")
        if op != "shutdown" and protocol_version != PROTOCOL_VERSION:
            generation = command.get("generation")
            self.emit({
                "ev": "phase",
                "phase": "error",
                "error": "Incompatible bridge protocol version.",
                "errorKind": "protocol",
                "generation": generation if isinstance(generation, int)
                else self.generation,
            })
            return

        if op == "shutdown":
            self.running = False
        elif op == "config":
            self.apply_config(command)
        elif op == "disconnect":
            self.apply_disconnect(command)
        elif op == "refresh":
            self.refresh()
        elif op == "registries":
            self.request_registries()
        elif op == "call_service":
            self.call_service(command)
        else:
            self.log("warn", "unknown op %r" % op)

    def apply_config(self, command):
        raw_url = command.get("url") or ""
        url = raw_url.strip() if isinstance(raw_url, str) else ""
        token = command.get("token") or ""
        if not isinstance(token, str):
            token = ""

        supplied_generation = command.get("generation")
        if isinstance(supplied_generation, int) and supplied_generation >= 0:
            next_generation = supplied_generation
        else:
            next_generation = self.generation + 1

        if (next_generation == self.generation and url == self.url
                and token == self.token and self.transport is not None):
            return

        # Finish the old generation before changing the label on emitted
        # failures; QML can then discard them deterministically.
        self.disconnect()
        self.generation = next_generation
        self.url = url
        self.token = token
        self.want_connect = self.demo or bool(url and token)
        self.backoff = BACKOFF_START
        self.next_attempt = 0.0
        self.auth_invalid_count = 0
        if not self.want_connect:
            self.set_phase("idle", force=True)

    def apply_disconnect(self, command):
        self.disconnect()
        supplied_generation = command.get("generation")
        if isinstance(supplied_generation, int) and supplied_generation >= 0:
            self.generation = supplied_generation
        else:
            self.generation += 1
        self.want_connect = False
        self.url = ""
        self.token = ""
        self.set_phase("idle", force=True)

    def refresh(self):
        if not self.authenticated:
            return
        self.request("get_states", {"type": "get_states"})
        self.request_registries()
        self.request("config", {"type": "get_config"})

    def call_service(self, command):
        domain = command.get("domain")
        service = command.get("service")
        entity_id = command.get("entity_id")
        tag = command.get("tag")
        if not isinstance(domain, str) or not domain:
            self.emit_result(tag, False, "Invalid service domain.")
            return
        if not isinstance(service, str) or not service:
            self.emit_result(tag, False, "Invalid service name.")
            return
        if entity_id is not None and not isinstance(entity_id, str):
            self.emit_result(tag, False, "Invalid entity id.")
            return
        raw_data = command.get("data") or {}
        if not isinstance(raw_data, dict):
            self.emit_result(tag, False, "Service data must be an object.")
            return
        payload = {
            "type": "call_service",
            "domain": domain,
            "service": service,
            "service_data": dict(raw_data),
        }
        if entity_id:
            payload["target"] = {"entity_id": entity_id}
        self.request("call_service", payload, tag=tag)

    # -- request plumbing --------------------------------------------------

    def next_id(self):
        current = self.msg_id
        self.msg_id += 1
        return current

    def emit_result(self, tag, ok, error=""):
        if not tag:
            return
        payload = {"ev": "result", "tag": str(tag), "ok": bool(ok)}
        if error:
            payload["error"] = self.safe_error(error)
            payload["errorKind"] = "command"
        self.emit(payload)

    def request(self, kind, payload, tag=None, critical=False, batch=None):
        if not self.transport or not self.authenticated:
            self.emit_result(tag, False, "Not connected to Home Assistant.")
            return None
        if kind == "call_service" and self.phase != "connected":
            self.emit_result(tag, False, "Home Assistant is still synchronizing.")
            return None
        msg_id = self.next_id()
        payload = dict(payload)
        payload["id"] = msg_id
        self.pending[msg_id] = {
            "kind": kind, "tag": tag,
            "deadline": now() + REQUEST_TIMEOUT,
            "critical": critical,
            "epoch": self.transport_epoch,
            "batch": batch,
        }
        try:
            self.transport.send(payload)
        except Exception as exc:
            self.pending.pop(msg_id, None)
            self.fail_connection(
                "send failed: %s" % exc,
                "synchronization" if critical else "connection")
            return None
        return msg_id

    def request_registries(self):
        self.registry_batch += 1
        batch = self.registry_batch
        self.registry = {}
        self.registry_failed = set()
        self.registry_pending = {"areas", "entity_registry", "device_registry"}
        requests = (
            ("areas", "config/area_registry/list"),
            ("entity_registry", "config/entity_registry/list"),
            ("device_registry", "config/device_registry/list"),
        )
        for kind, request_type in requests:
            if self.request(kind, {"type": request_type}, batch=batch) is None:
                self.finish_registry_part(kind, [], failed=True, batch=batch)

    def finish_registry_part(self, kind, result, failed=False, batch=None):
        if batch is not None and batch != self.registry_batch:
            return
        self.registry[kind] = result if isinstance(result, list) else []
        if failed or not isinstance(result, list):
            self.registry_failed.add(kind)
        self.registry_pending.discard(kind)
        if self.registry_pending:
            return
        missing = sorted(self.registry_failed)
        self.emit({
            "ev": "registries",
            "areas": self.registry.get("areas", []),
            "entities": self.registry.get("entity_registry", []),
            "devices": self.registry.get("device_registry", []),
            "partial": bool(missing),
            "missing": missing,
        })

    def expire_requests(self):
        current = now()
        for msg_id in [i for i, p in self.pending.items() if p["deadline"] <= current]:
            pending = self.pending.pop(msg_id)
            kind = pending["kind"]
            if pending["tag"]:
                self.emit_result(pending["tag"], False,
                                 "Home Assistant did not answer in time.")
            elif kind in ("areas", "entity_registry", "device_registry"):
                self.log("warn", "request %s (%s) timed out" % (msg_id, kind))
                self.finish_registry_part(
                    kind, [], failed=True, batch=pending.get("batch"))
            else:
                self.log("warn", "request %s (%s) timed out" % (msg_id, kind))
            if pending["critical"]:
                self.fail_connection(
                    "Initial Home Assistant synchronization timed out.",
                    "synchronization")
                return

    # -- connection lifecycle ---------------------------------------------

    @staticmethod
    def explain(error):
        """Turn a socket exception into something a user can act on.

        The raw text is what Python hands back — "[Errno -3] Temporary failure
        in name resolution" tells someone who mistyped a hostname nothing about
        what to fix.
        """
        text = str(error)
        if isinstance(error, socket.gaierror) or "name resolution" in text:
            return "Cannot find that host — check the address."
        if isinstance(error, ConnectionRefusedError) or "refused" in text:
            return "Nothing is listening there — check the port."
        if isinstance(error, socket.timeout) or "timed out" in text:
            return "The host did not answer in time."
        if isinstance(error, ssl.SSLError) or "certificate" in text.lower():
            return "TLS failed: " + text
        return text

    def connect(self):
        self.set_phase("connecting")
        try:
            if self.demo:
                self.transport = DemoTransport()
            else:
                self.transport = WsTransport(
                    self.websocket_url(), verify_tls=self.verify_tls)
        except (WebSocketError, ValueError) as exc:
            # A URL we cannot even parse will not start working on its own, so
            # retrying it just spins. Wait for the shell to send a better one.
            # ValueError is belt and braces: websocket_url already converts the
            # ones urllib raises, and this loop must not be able to die on a
            # parse error the shell cannot see and cannot restart us from.
            self.transport = None
            self.set_phase("error", self.safe_error(exc))
            self.want_connect = False
            return

        try:
            self.transport.connect()
        except Exception as exc:
            self.transport = None
            self.schedule_retry(self.explain(exc))
            return
        self.transport_epoch += 1
        self.authenticated = False
        self.subscription_ready = False
        self.snapshot_ready = False

    def websocket_url(self):
        # Every parse step below can raise ValueError on input the settings
        # overlay was willing to accept: urlsplit rejects an unbalanced bracket
        # ("https://ha.local:8123]") with "Invalid IPv6 URL", and .hostname and
        # .port reject a malformed authority or a non-numeric port. Uncaught,
        # any of those kills the whole bridge process for what is really just a
        # typo, so the entire parse is funnelled into WebSocketError.
        try:
            parts = urllib.parse.urlsplit(self.url)
            # "homeassistant.local:8123" parses as scheme "homeassistant.local"
            # with no netloc, and "//homeassistant.local:8123" as a netloc with
            # no scheme. Both are natural things to type, and both need the
            # same repair. Assume TLS: guessing http would quietly put the
            # token on the wire in the clear.
            if not parts.scheme or not parts.netloc:
                parts = urllib.parse.urlsplit("https://" + self.url.lstrip("/"))
            scheme = WS_SCHEMES.get(parts.scheme)
            if scheme is None:
                # Never fall back to ws:// here. A typo like "htps://" would then
                # send a long-lived access token unencrypted.
                raise WebSocketError(
                    "unsupported scheme %r — use http:// or https://" % parts.scheme)
            if not parts.hostname:
                raise WebSocketError("no host in URL: %s" % self.url)
            if parts.username or parts.password:
                raise WebSocketError(
                    "credentials aren't allowed in the Home Assistant URL")
            parts.port
        except ValueError as exc:
            raise WebSocketError(
                "invalid Home Assistant URL: %s" % exc) from exc
        base_path = parts.path.rstrip("/")
        path = base_path if base_path.endswith("/api/websocket") \
            else base_path + "/api/websocket"
        return urllib.parse.urlunsplit((scheme, parts.netloc, path, "", ""))

    def disconnect(self):
        if self.transport:
            try:
                self.transport.close()
            except Exception:
                pass
        self.transport = None
        self.authenticated = False
        self.subscription_ready = False
        self.snapshot_ready = False
        self.registry_pending = set()
        for pending in self.pending.values():
            if pending["tag"]:
                self.emit_result(pending["tag"], False, "Connection lost.")
        self.pending = {}

    def schedule_retry(self, message, error_kind="connection"):
        self.disconnect()
        self.set_phase("error" if self.backoff >= BACKOFF_MAX else "connecting",
                       message, error_kind=error_kind)
        self.next_attempt = now() + self.backoff
        self.backoff = min(self.backoff * 2, BACKOFF_MAX)

    def fail_connection(self, message, error_kind="connection"):
        safe = self.safe_error(message)
        self.log("warn", safe)
        self.schedule_retry(safe, error_kind)

    # -- protocol dispatch -------------------------------------------------

    def handle_message(self, msg):
        kind = msg.get("type")
        if kind == "auth_required":
            self.transport.send({"type": "auth", "access_token": self.token or "demo"})
        elif kind == "auth_ok":
            self.on_auth_ok()
        elif kind == "auth_invalid":
            self.on_auth_invalid(msg)
        elif kind == "result":
            self.handle_result(msg)
        elif kind == "event":
            self.handle_event(msg)

    def on_auth_ok(self):
        self.authenticated = True
        self.auth_invalid_count = 0
        self.backoff = BACKOFF_START
        self.subscription_ready = False
        self.snapshot_ready = False
        if self.request("subscribe", {"type": "subscribe_events",
                                      "event_type": "state_changed"},
                        critical=True) is None:
            return
        if self.request("get_states", {"type": "get_states"},
                        critical=True) is None:
            return
        self.request_registries()
        # Climate entities carry no unit of their own; the instance decides.
        self.request("config", {"type": "get_config"})

    def on_auth_invalid(self, msg):
        raw_message = msg.get("message") or ""
        message = raw_message.strip() if isinstance(raw_message, str) else ""
        message = message or "Authentication failed."
        current = now()
        if current - self.auth_invalid_at < 30.0:
            self.auth_invalid_count += 1
        else:
            self.auth_invalid_count = 1
        self.auth_invalid_at = current

        if self.auth_invalid_count == 1:
            self.log("info", "auth rejected once, retrying: %s"
                     % self.safe_error(message))
            self.disconnect()
            self.set_phase("connecting")
            self.next_attempt = now() + 2.0
            return

        self.disconnect()
        self.set_phase("error", message, error_kind="credential")
        # A bad token is not fixed by retrying. Stop until the shell sends a
        # fresh config, otherwise we spin against the server forever.
        self.want_connect = False

    def handle_result(self, msg):
        msg_id = msg.get("id")
        pending = self.pending.pop(msg_id, None)
        if pending is None:
            return
        if pending["epoch"] != self.transport_epoch:
            return
        kind = pending["kind"]
        tag = pending["tag"]
        success = bool(msg.get("success"))

        if not success:
            error_obj = msg.get("error") or {}
            raw_error = error_obj.get("message") if isinstance(error_obj, dict) else ""
            error = raw_error if isinstance(raw_error, str) and raw_error \
                else "Home Assistant rejected the request."
            if tag:
                self.emit_result(tag, False, error)
            elif kind in ("areas", "entity_registry", "device_registry"):
                self.log("warn", "%s failed: %s" % (kind, self.safe_error(error)))
                self.finish_registry_part(
                    kind, [], failed=True, batch=pending.get("batch"))
            elif pending["critical"]:
                self.fail_connection(
                    "Initial %s request failed: %s" % (kind, error),
                    "synchronization")
            else:
                self.log("warn", "%s failed: %s" % (kind, self.safe_error(error)))
            return

        result = msg.get("result")
        if kind == "subscribe":
            self.subscription_ready = True
            self.maybe_ready()
        elif kind == "get_states":
            if not isinstance(result, list):
                if pending["critical"]:
                    self.fail_connection(
                        "Home Assistant returned an invalid state snapshot.",
                        "synchronization")
                else:
                    self.log("warn", "Home Assistant returned an invalid state snapshot")
                return
            self.emit({"ev": "states", "entities": result})
            if pending["critical"]:
                self.snapshot_ready = True
                self.maybe_ready()
        elif kind in ("areas", "entity_registry", "device_registry"):
            self.finish_registry_part(kind, result, batch=pending.get("batch"))
        elif kind == "config":
            units = result.get("unit_system") if isinstance(result, dict) else {}
            units = units if isinstance(units, dict) else {}
            self.emit({"ev": "config",
                       "unit_temperature": units.get("temperature", "")})
        elif tag:
            self.emit_result(tag, True)

    def maybe_ready(self):
        if self.subscription_ready and self.snapshot_ready:
            self.set_phase("connected")

    def handle_event(self, msg):
        event = msg.get("event") or {}
        if not isinstance(event, dict):
            return
        if event.get("event_type") != "state_changed":
            return
        data = event.get("data") or {}
        if not isinstance(data, dict):
            return
        new_state = data.get("new_state")
        if new_state is None:
            entity_id = data.get("entity_id")
            if entity_id:
                self.emit({"ev": "removed", "entity_id": entity_id})
            return
        if isinstance(new_state, dict) and isinstance(new_state.get("entity_id"), str):
            self.emit({"ev": "state_changed", "entity": new_state})

    # -- main loop ---------------------------------------------------------

    def run(self):
        reader = threading.Thread(target=self.stdin_loop, daemon=True)
        reader.start()

        while self.running:
            self.drain_commands()
            if not self.running:
                break

            if self.transport is None and self.want_connect and now() >= self.next_attempt:
                self.connect()

            transport = self.transport
            if transport is not None:
                try:
                    msg = transport.receive(timeout=0.2)
                    if msg is not None and self.transport is transport:
                        self.handle_message(msg)
                except WebSocketError as exc:
                    if self.transport is transport:
                        self.fail_connection(str(exc))
                except Exception as exc:
                    if self.transport is transport:
                        self.fail_connection("read failed: %s" % exc)
            else:
                wait_for = 0.2
                if self.want_connect:
                    wait_for = max(0.0, min(wait_for, self.next_attempt - now()))
                self._command_event.wait(wait_for)

            self.expire_requests()

        self.disconnect()


def main(argv):
    demo = "--demo" in argv
    verify_tls = "--insecure" not in argv
    if not verify_tls:
        sys.stderr.write("hass-bridge: TLS verification disabled\n")
    Bridge(demo=demo, verify_tls=verify_tls).run()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
