            "supported_color_modes": ["color_temp", "hs"]}),
        entity("fan.living_room_ceiling_fan", "on", {
            "friendly_name": "Living Room Ceiling Fan", "icon": "mdi:fan"}),
        entity("climate.living_room_thermostat", "heat", {
            "friendly_name": "Living Room Thermostat", "hvac_action": "heating",
