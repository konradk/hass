.venv/
__pycache__/
*.pyc
*.qmlc
*.jsc

# A development symlink makes the plugin write its local settings here.
# It never contains the Miniserver password, but may contain a private
# Miniserver URL, room names, entity IDs, and display-name overrides.
/config.json

# Keep ad-hoc local secrets and diagnostic output out of a public checkout.
.env
.env.*
!.env.example
*.log
